{
  "manifest_version": 3,
  "name": "BrandVibe",
  "version": "1.0.0",
  "description": "Extract brand personality, voice, color palette, and social media marketing trends from any website.",
  "permissions": ["activeTab", "storage", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "BrandVibe",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
